# ════════════════════════════════════════════════════════════
# InfoPago RH — Variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e preencha com suas credenciais.
# NUNCA commite o arquivo `.env` com chaves reais!
# ════════════════════════════════════════════════════════════

PORT=3001
NODE_ENV=development

# ── Supabase ──
# Pegue no painel: Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Gmail SMTP ──
# Use uma "Senha de App" do Google (16 caracteres SEM espaços)
# Crie em: https://myaccount.google.com/apppasswords
GMAIL_USER=seu.email@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# ── Agente IA (Claude) ──
# Crie em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Segurança ──
JWT_SECRET=troque-isso-por-uma-string-aleatoria-longa

# ── URL pública (usada nos links de confirmação de e-mail) ──
# Em produção: https://seu-dominio.com.br
PUBLIC_URL=http://localhost:3001
